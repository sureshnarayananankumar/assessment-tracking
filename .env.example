# =====================================================================
# AssessHub environment configuration
# Copy to .env and fill in real values:   cp .env.example .env
# NEVER commit .env or real secrets to source control.
# =====================================================================

# ---- Docker Compose profiles -----------------------------------------
# local-db   = run MySQL 8.4 in Docker (persistent volume)
# local-mail = run MailHog (captures all e-mails at http://localhost:8026)
# For an existing MySQL Server (managed in MySQL Workbench) remove local-db.
COMPOSE_PROFILES=local-db,local-mail

# ---- Host ports ---------------------------------------------------------
FRONTEND_HOST_PORT=8090
BACKEND_HOST_PORT=8080
MYSQL_HOST_PORT=3308
MAILHOG_UI_PORT=8026

# ---- Database -----------------------------------------------------------
# Docker MySQL: DB_HOST=mysql (service name).
# MySQL Server on this machine (Workbench): DB_HOST=host.docker.internal
# Remote/managed MySQL: DB_HOST=<hostname>  and use DB_PARAMS=sslMode=VERIFY_IDENTITY&...
DB_HOST=mysql
DB_PORT=3306
DB_NAME=assesshub
DB_USERNAME=assesshub_app
DB_PASSWORD=change-me-strong-db-password
# Only used by the local-db MySQL container
MYSQL_ROOT_PASSWORD=change-me-strong-root-password
# Optional JDBC parameters (default shown)
# DB_PARAMS=sslMode=PREFERRED&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&characterEncoding=UTF-8
# If you created the tables manually in Workbench (database/02 + 03), let Flyway adopt them:
# FLYWAY_BASELINE_ON_MIGRATE=true
# FLYWAY_BASELINE_VERSION=2

# ---- Security -------------------------------------------------------------
# At least 32 bytes. Generate with:  openssl rand -base64 48
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
# true when served over HTTPS (production)
COOKIE_SECURE=false
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---- URLs -----------------------------------------------------------------
# Public URL of the web app (used in e-mail links)
FRONTEND_URL=http://localhost:8090
# Comma-separated list of browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:8090,http://localhost:5174

# ---- First Super Admin (created once, only if none exists) -------------------
# Password: 8-128 chars with letters and numbers. Remove it from .env after first start.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Super Admin

# ---- E-mail (SMTP) --------------------------------------------------------------
# Local development: MailHog (no auth). Production examples:
#   SendGrid : MAIL_HOST=smtp.sendgrid.net MAIL_PORT=587 MAIL_USERNAME=apikey MAIL_PASSWORD=<api key>
#   Mailgun  : MAIL_HOST=smtp.mailgun.org  MAIL_PORT=587
#   AWS SES  : MAIL_HOST=email-smtp.<region>.amazonaws.com MAIL_PORT=587
#   Gmail/M365 (app password): smtp.gmail.com / smtp.office365.com port 587
# with MAIL_SMTP_AUTH=true and MAIL_SMTP_STARTTLS=true
MAIL_ENABLED=true
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@assesshub.local
MAIL_FROM_NAME=Business Gateways International
# Development only: also print invitation/reset links in the backend log
MAIL_LOG_LINKS=false

# ---- Optional demo data (development only) -----------------------------------
# Creates recruiter@demo.local and candidate@demo.local with DEMO_USER_PASSWORD
DEMO_DATA_ENABLED=false
DEMO_USER_PASSWORD=

# ---- Misc -----------------------------------------------------------------------
SWAGGER_ENABLED=true
APP_LOG_LEVEL=INFO
